# Copy this file to .env in the same directory and fill in real values.
# .env must be gitignored - it holds production secrets.

# MSSQL sa password. Requirements: 8+ chars, with uppercase, lowercase,
# digits and symbols. Generate one with: openssl rand -base64 24
SA_PASSWORD=CHANGE_ME_strong_password_here

# Name of the application database.
DB_NAME=AppDb

# The Cloudflare Tunnel token lives in deploy/edge/.env instead - one shared
# tunnel fronts every project on the domain, not one tunnel per project.
