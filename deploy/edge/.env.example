# Copy this file to .env in this same directory and fill in the real value.
# .env must be gitignored - it holds a production secret.

# Cloudflare Tunnel token. Get this from:
# Cloudflare dashboard > Zero Trust > Networks > Tunnels > create tunnel > Docker
# This is the SAME tunnel used for the whole domain, not one per project -
# individual projects (e.g. deploy/.env for clinicbook) no longer need this.
TUNNEL_TOKEN=CHANGE_ME_tunnel_token_here
