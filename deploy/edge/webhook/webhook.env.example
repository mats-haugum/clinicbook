# Copy to /opt/webhook/webhook.env on the server and fill in real secrets.
# Never commit the real file - it holds a deploy secret per project.
#
# Each secret must match exactly what you paste into GitHub's webhook
# settings for that repo (Settings > Webhooks > Secret).

WEBHOOK_SECRET_CLINICBOOK=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Absolute path to this repo's checkout on the server. hooks.json reads it
# with {{ getenv }} (which is why webhook.service passes -template), so the
# server's directory layout is never committed to this public repo.
CLINICBOOK_REPO_DIR=/CHANGE_ME/path/to/clinicbook

# Optional. Where redeploy.sh appends its one-line deploy record. Defaults to
# <repo>/deploy/deploy.log, which is gitignored; set this to somewhere like
# /var/log/clinicbook-deploy.log if you would rather it lived outside the
# checkout - that file must be writable by the service account.
# DEPLOY_LOG=/var/log/clinicbook-deploy.log

# Optional. Branch redeploy.sh deploys. Defaults to main, and must match the
# ref that hooks.json gates on.
# DEPLOY_BRANCH=main

# Add one line per additional project, matching a new entry in hooks.json:
# WEBHOOK_SECRET_OTHER_APP=CHANGE_ME
# OTHER_APP_REPO_DIR=/CHANGE_ME/path/to/other-app
