# Copy to /opt/webhook/webhook.env on the server and fill in real secrets.
# Never commit the real file - it holds a deploy secret per project.
#
# Each secret must match exactly what you paste into GitHub's webhook
# settings for that repo (Settings > Webhooks > Secret).

WEBHOOK_SECRET_CLINICBOOK=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Add one line per additional project, matching a new entry in hooks.json:
# WEBHOOK_SECRET_OTHER_APP=CHANGE_ME
