[
  {
    "id": "clinicbook",
    "execute-command": "{{ getenv `CLINICBOOK_REPO_DIR` }}/deploy/redeploy.sh",
    "command-working-directory": "{{ getenv `CLINICBOOK_REPO_DIR` }}",
    "response-message": "deploying clinicbook",
    "pass-arguments-to-command": [
      {
        "source": "payload",
        "name": "workflow_run.head_sha"
      }
    ],
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "{{ getenv `WEBHOOK_SECRET_CLINICBOOK` }}",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "completed",
            "parameter": {
              "source": "payload",
              "name": "action"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "success",
            "parameter": {
              "source": "payload",
              "name": "workflow_run.conclusion"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "CI",
            "parameter": {
              "source": "payload",
              "name": "workflow_run.name"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "push",
            "parameter": {
              "source": "payload",
              "name": "workflow_run.event"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "main",
            "parameter": {
              "source": "payload",
              "name": "workflow_run.head_branch"
            }
          }
        }
      ]
    }
  }
]
