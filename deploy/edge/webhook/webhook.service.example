[Unit]
Description=GitHub webhook listener (multi-project auto-deploy)
After=network.target docker.service
Requires=docker.service

[Service]
# webhook binds to loopback only - ufw's default-deny-incoming already
# blocks it from the outside world, but there's no reason to widen that.
# The edge Caddy container reaches it via the Docker host gateway instead
# (see deploy/edge/docker-compose.yml's extra_hosts on the caddy service).
# -template is REQUIRED: without it, webhook treats the {{ getenv "..." }}
# expressions in hooks.json as literal text, so signature verification
# compares against the template string itself and every delivery fails.
ExecStart=/usr/bin/webhook -hooks /opt/webhook/hooks.json -template -verbose -ip 127.0.0.1 -port 9000
Restart=on-failure
EnvironmentFile=/opt/webhook/webhook.env

# Copy this file to /etc/systemd/system/webhook.service and set both fields
# to the account that owns the checkout - redeploy.sh has to `git reset
# --hard` and run a Docker build inside it. That account must be in the
# `docker` group, which is itself effectively root-equivalent (anyone who can
# reach the Docker daemon can mount the host filesystem into a container) -
# the same trade-off a Docker-socket-mounted container would carry.
# Signature verification in hooks.json is the only thing standing between the
# outside world and this account, so keep the secrets in webhook.env
# unguessable. The real unit is deliberately left uncommitted: this repo is
# public, and the service account name is not worth publishing.
User=CHANGE_ME
Group=CHANGE_ME

[Install]
WantedBy=multi-user.target
