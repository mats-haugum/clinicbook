{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# `handle_path /projects/<name>/*` matches the trailing-slash form and
	# anything below it, but NOT the bare /projects/<name> - that would fall
	# through to the 404 handler below. Redirect it to the canonical
	# trailing-slash URL first. This also matters for the SPA itself: with no
	# trailing slash the browser resolves relative asset URLs against
	# /projects/ instead of /projects/<name>/. 308 (not 302) so the method and
	# body of a non-GET request survive the redirect. One regex covers every
	# project, so new handle_path blocks need nothing added here.
	@project_root path_regexp proj ^/projects/([^/]+)$
	redir @project_root /projects/{re.proj.1}/ 308

	# handle_path matches a URL prefix AND strips it before forwarding, so
	# a request for /projects/clinicbook/api/doctors arrives at clinicbook's
	# own Caddy container as just /api/doctors - it never needs to know it's
	# being served under a subpath.
	handle_path /projects/clinicbook/* {
		reverse_proxy clinicbook-web:80 {
			header_up X-Forwarded-Proto https
		}
	}

	# Add one handle_path block per project as you deploy more of them, e.g.:
	# handle_path /projects/other-app/* {
	# 	reverse_proxy other-app-web:80 {
	# 		header_up X-Forwarded-Proto https
	# 	}
	# }

	# GitHub's webhook POSTs land here. `handle` (not handle_path) keeps the
	# full path, since the `webhook` binary itself expects /hooks/<project-id>
	# - see deploy/edge/webhook/. It runs on the host, not in a container, so
	# this reaches it via the Docker host gateway rather than a service name.
	handle /hooks/* {
		reverse_proxy host.docker.internal:9000
	}

	handle {
		respond "Not found" 404
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format console
	}
}
