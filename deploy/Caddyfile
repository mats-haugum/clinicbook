{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# handle_path (not handle) strips the /api prefix before forwarding: the
	# controllers are routed at the root ([Route("doctors")], not
	# [Route("api/doctors")]), so the API never sees /api itself. The prefix
	# exists only to separate API calls from SPA routes in this Caddyfile.
	handle_path /api/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Hashed build assets never change - cache them hard.
	@hashed path /assets/* /static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# The HTML entrypoint must always be revalidated or users get a stale app shell.
	header /index.html Cache-Control "no-cache"

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	log {
		output stdout
		format console
	}
}
