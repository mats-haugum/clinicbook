{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# handle_path (not handle) strips the /api prefix before forwarding: the
	# controllers are routed at the root ([Route("doctors")], not
	# [Route("api/doctors")]), so the API never sees /api itself. The prefix
	# exists only to separate API calls from SPA routes in this Caddyfile.
	handle_path /api/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		# The no-cache header below must be applied AFTER try_files, so it has
		# to live inside an explicit `route` - directives there run in written
		# order, whereas Caddy otherwise sorts `header` ahead of `handle` and
		# it would only ever see the original request path. try_files rewrites
		# every unmatched SPA route to /index.html, so matching the rewritten
		# path is what catches "/" and deep links like /doctors; a top-level
		# `header /index.html` matches only a literal request for /index.html.
		route {
			try_files {path} /index.html
			header /index.html Cache-Control "no-cache"
			file_server
		}
	}

	# Hashed build assets never change - cache them hard. These are real files,
	# so try_files never rewrites them and matching the request path is correct.
	@hashed path /assets/* /static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	log {
		output stdout
		format console
	}
}
